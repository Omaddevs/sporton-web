{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "ignorePatterns": [
    "backend/**",
    "dist/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "overrides": [
    {
      "files": [
        "vite.config.js",
        "scripts/**",
        "tests/**"
      ],
      "env": {
        "node": true,
        "es2024": true
      }
    }
  ]
}
