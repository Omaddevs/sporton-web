# docker compose uchun (.env nomi bilan saqlang). HTTPS — oldida Caddy/Cloudflare/certbot.
POSTGRES_PASSWORD=
AUTH_SECRET=            # openssl rand -base64 48
PUBLIC_SITE_URL=https://sporton.uz
# Admin panel va majmua kabineti — sayt bilan bitta domen bo‘lsa bo‘sh qoldiring
PUBLIC_PANEL_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=sporton_kirish_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
VITE_TELEGRAM_BOT_ID=
GOOGLE_CLIENT_ID=
HTTP_PORT=80
# Brauzer push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@sporton.uz
# Zaxira nusxalari necha kun saqlansin (backup xizmati)
BACKUP_KEEP_DAYS=14
