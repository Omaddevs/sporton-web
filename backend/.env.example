# ── Ma’lumotlar bazasi ──────────────────────────────────────────────
# Production: PostgreSQL 14+ manzili. Bo‘sh qoldirilsa (faqat dev) — ./.data/pglite ichida
# o‘rnatilgan Postgres (PGlite) ishlatiladi, hech narsa o‘rnatish shart emas.
DATABASE_URL=

# ── Xavfsizlik ─────────────────────────────────────────────────────
# Kamida 32 belgili tasodifiy satr:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Frontend manzil(lar)i — CORS uchun, vergul bilan (dev: Vite)
CORS_ORIGINS=http://localhost:5173
# Sessiya cookie: frontend va API boshqa domenlarda bo‘lsa "none" (HTTPS shart)
COOKIE_SAMESITE=lax

# ── Fayllar ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Telegram bot (parolni tiklash kodi) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=sporton_kirish_bot
# Webhook so‘rovlarini tekshirish uchun maxfiy satr (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Yangi bron/arizalar haqida xabar yuboriladigan admin chat id (ixtiyoriy)
TELEGRAM_ADMIN_CHAT_ID=
# Lokal ishlab chiqish: webhook o‘rniga botdan getUpdates bilan o‘qish (1 — yoqilgan). Production’da bo‘sh qoldiring
TELEGRAM_POLLING=

# ── Google orqali kirish (ixtiyoriy) ───────────────────────────────
GOOGLE_CLIENT_ID=

# ── Birinchi admin (npm run admin:create) ──────────────────────────
ADMIN_PHONE=901234567
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
PUBLIC_SITE_URL=http://localhost:5173

# Yuklash chegaralari (MB)
MAX_IMAGE_MB=15
MAX_VIDEO_MB=200

# Brauzer push bildirishnomalari: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@sporton.uz
# Admin panel va majmua kabineti manzili. Production’da bo‘sh (sayt bilan bitta domen), lokalda http://localhost:3001
PUBLIC_PANEL_URL=
