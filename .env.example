# Backend manzili. Bo‘sh — frontend bilan bir domenda (nginx /api ni backendga yo‘naltiradi)
VITE_API_URL=
# Parolni tiklash boti (t.me/<username>)
VITE_TELEGRAM_BOT=sporton_kirish_bot
# Telegram Login Widget uchun bot id (tokenning ":" dan oldingi qismi). Bo‘sh — tugma «tez orada»
VITE_TELEGRAM_BOT_ID=
# Google Identity Services client id. Bo‘sh — tugma «tez orada»
VITE_GOOGLE_CLIENT_ID=
# Admin panel va majmua kabineti manzili. Bo‘sh — sayt bilan bitta domen (nginx /kabinet ni backendga yo‘naltiradi)
VITE_PANEL_URL=
